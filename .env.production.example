# ============================================================
# 生产环境模板（V2-5 云端部署）：cp .env.production.example .env
# docker compose 自动读取本文件并注入各容器；禁止提交真实值。
# 完整部署步骤见 docs/DEPLOY.md；部署前跑 bash scripts/preflight.sh。
# ============================================================

# ===== 站点 / HTTPS =====
# 域名（DNS A 记录须已指向服务器，Caddy 自动签发 Let's Encrypt 证书）
# 无域名仅内网使用时可填 :80（明文 HTTP，仅限可信网络）
SITE_ADDRESS=fitness.example.com

# ===== PostgreSQL =====
POSTGRES_USER=fitness
# 强口令，例：openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=fitness
# backend 的 DATABASE_URL 由 docker-compose 按上面三项自动拼装：
#   postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# 仅当改用外部数据库时才需要手动覆盖 DATABASE_URL

# ===== 应用（强制）=====
APP_ENV=production
# 登录口令（全站访问控制，生产强制；缺失时后端拒绝启动）
APP_PASSWORD=
# Fernet 主密钥：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ===== 第三方凭据 =====
# 训记 Open API Key（App 内申请）
XUNJI_API_KEY=
# 训记身体数据 API Key（xjbody_ 前缀）
XUNJI_BODY_API_KEY=
# 训记饮食 API Key（本期不开发，仅占位备案）
XUNJI_FOOD_API_KEY=
XUNJI_FOOD_SEARCH_KEY=
# 佳明账号（无 MFA）；token 缓存于 garmin_tokens 卷，避免重复登录触发 IP 级 429
GARMIN_EMAIL=
GARMIN_PASSWORD=
# 佳明域名：中国区账号固定 garmin.cn（全球区登录成功但返回空数据，勿改）
GARMIN_DOMAIN=garmin.cn

# ===== LLM API Keys =====
KIMI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# ===== 历史回溯起点 =====
BACKFILL_START_DATE=2023-02-01
GARMIN_BACKFILL_START_DATE=2017-01-01

# ===== 备份 =====
# pg_dump 每日 03:17，滚动保留天数（PRD §7：30 天）
BACKUP_RETENTION_DAYS=30

# ===== 告警推送（Server酱 SendKey 或 SMTP，V2-4）=====
SERVERCHAN_SENDKEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# LLM 成本单价表覆盖（JSON，元/1M tokens），可选
# LLM_PRICES_JSON={"deepseek": {"prompt": 1.0, "completion": 2.0}}
