# ===== 第三方凭据（开发期填本机 .env，禁止提交真实值）=====
# 训记 Open API Key（App 内申请）
XUNJI_API_KEY=
# 训记身体数据 API Key（2026-08-03 新版 Key 文件新增，xjbody_ 前缀）
XUNJI_BODY_API_KEY=
# 训记饮食 API Key（本期不开发，仅占位备案）
XUNJI_FOOD_API_KEY=
XUNJI_FOOD_SEARCH_KEY=
# 佳明账号（无 MFA）
GARMIN_EMAIL=
GARMIN_PASSWORD=
# 佳明域名：中国区账号固定 garmin.cn（全球区登录成功但返回空数据，勿改）
GARMIN_DOMAIN=garmin.cn
# Fernet 主密钥：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ===== LLM API Keys =====
KIMI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# ===== 数据库 =====
# 开发期 SQLite；生产期 PostgreSQL
DATABASE_URL=sqlite:///./backend/data/app.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/fitness

# ===== 应用 =====
# 登录口令（全站访问控制）
APP_PASSWORD=
# 历史回溯起点
BACKFILL_START_DATE=2023-02-01
# 告警推送（Server酱 SendKey 或 SMTP 配置，V2-4 启用）
SERVERCHAN_SENDKEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

